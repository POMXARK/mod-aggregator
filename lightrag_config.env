###########################
### Server Configuration
###########################

HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='My Graph KB'
WEBUI_DESCRIPTION="Simple and Fast Graph Based RAG System"
OLLAMA_EMULATING_MODEL_TAG=latest

######################################################################################
### Query Configuration
######################################################################################

ENABLE_LLM_CACHE=true

#########################################################
### Reranking configuration
#########################################################

RERANK_BINDING=null

########################################
### Document processing configuration
########################################

ENABLE_LLM_CACHE_FOR_EXTRACT=true
SUMMARY_LANGUAGE=English

# Оптимальный размер чанков для Gemma 2B
CHUNK_SIZE=512  # Увеличен для лучшей производительности
CHUNK_OVERLAP_SIZE=50

###############################
### Concurrency Configuration
###############################

# Параллелизм 6 для Gemma 2B
MAX_ASYNC=6  # Увеличен до 6 как запрошено
MAX_PARALLEL_INSERT=2  # Умеренный параллелизм для вставки

###########################################################################
### LLM Configuration - Ollama (gemma:2b)
###########################################################################

# Переключено на локальную модель Ollama
LLM_BINDING=ollama
LLM_MODEL=gemma:2b

# Локальный хост Ollama
LLM_BINDING_HOST=http://host.docker.internal:11434
LLM_BINDING_API_KEY=

# Оптимизированные настройки для Gemma 2B
LLM_TIMEOUT=120  # 2 минуты (локальная модель быстрее)
OLLAMA_LLM_NUM_CTX=8192  # Контекст для Gemma 2B
OLLAMA_LLM_NUM_PREDICT=1024  # Ограниченный вывод для скорости

#######################################################################################
### Embedding Configuration - Ollama (nomic-embed-text:latest)
#######################################################################################

# Embedding оставляем локальным
EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIM=768
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_BINDING_API_KEY=
EMBEDDING_TOKEN_LIMIT=8192
OLLAMA_EMBEDDING_NUM_CTX=8192
EMBEDDING_FUNC_MAX_ASYNC=6  # Увеличен до 6 для соответствия
EMBEDDING_BATCH_NUM=2

####################################################################
### WORKSPACE Configuration
####################################################################

WORKSPACE=gemma_2b_workspace











