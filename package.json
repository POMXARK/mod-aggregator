{
  "name": "mod-aggregator",
  "version": "1.0.0",
  "description": "Mod aggregator with parser builder - analog of ModOrganizer/NexusMods",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "npx eslint src/**/*.ts src/**/*.svelte",
    "lint:fix": "npx eslint src/**/*.ts src/**/*.svelte --fix",
    "lint:svelte-extensions": "npx eslint src/**/*.ts --fix --rule 'custom-rules/require-svelte-extension: error'",
    "format": "prettier --write src/**/*.{ts,svelte}",
    "format:check": "prettier --check src/**/*.{ts,svelte}",
    "type-check": "tsc --noEmit",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "analyze": "npm run type-check && npm run svelte-check && npm run lint && npm run rust-check && npm run markdown-check",
    "analyze:fix": "npm run format && npm run lint:fix && npm run rust-format && npm run markdown-fix",
    "rust-check": "cd src-tauri && cargo clippy",
    "rust-check-strict": "cd src-tauri && cargo clippy -- -D warnings",
    "rust-format": "cd src-tauri && cargo fmt",
    "rust-format-check": "cd src-tauri && cargo fmt --check",
    "rust-test": "cd src-tauri && cargo test",
    "rust-build": "cd src-tauri && cargo build",
    "rust-build-release": "cd src-tauri && cargo build --release",
    "markdown-check": "markdownlint '**/*.md'",
    "markdown-fix": "markdownlint --fix '**/*.md'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:test": "cypress run --spec 'cypress/e2e/refresh-button.cy.ts'",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:verbose": "RUST_LOG=debug tauri dev",
    "tauri:build": "tauri build",
    "docs:install": "cd website && npm install",
    "docs:start": "cd website && npm start",
    "docs:build": "cd website && npm run build",
    "docs:serve": "cd website && npm run serve",
    "docs:docker:build": "cd website && docker build -t mod-aggregator-docs .",
    "docs:docker:up": "cd website && docker-compose up -d",
    "docs:docker:down": "cd website && docker-compose down"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@xyflow/svelte": "^1.5.0",
    "bootstrap": "^5.3.3",
    "date-fns": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-routing": "^1.7.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.9",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "markdownlint-cli": "^0.47.0",
    "postcss": "^8.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte-check": "^3.6.0",
    "svelte-eslint-parser": "^1.4.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.50.1",
    "vite": "^5.0.0",
    "vitest": "^4.0.15"
  }
}
