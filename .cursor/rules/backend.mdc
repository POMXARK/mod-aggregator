/// # Возвращает
/// HTML содержимое страницы или ошибку
pub async fn fetch_page(
    app_handle: tauri::AppHandle, 
    url: String, 
    force_refresh: bool, 
    site_id: Option<i64>
) -> Result<String, String> {
    // ...
}
```

```rust
/// Структура для работы с базой данных
/// 
/// Предоставляет методы для работы с сайтами, модами и уведомлениями
pub struct Database {
    pool: SqlitePool,
}
```

## Тестирование

### Unit тесты

- Размещай unit тесты в том же файле, что и код (в модуле `#[cfg(test)]`)
- Тестируй отдельные функции и методы
- Используй `assert!`, `assert_eq!`, `assert_ne!` для проверок
- Используй `#[should_panic]` для тестов, которые должны паниковать
- Используй `#[tokio::test]` для async тестов

### Примеры unit тестов

```rust
#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_parse_url() {
        let url = "https://example.com/page";
        let parsed = parse_url(url).unwrap();
        assert_eq!(parsed.host(), Some("example.com"));
    }

    #[tokio::test]
    async fn test_async_function() {
        let result = fetch_data().await;
        assert!(result.is_ok());
    }
}
```

### Интеграционные тесты

- Размещай интеграционные тесты в `tests/` директории
- Тестируй взаимодействие между модулями
- Используй реальные зависимости (база данных, файловая система)
- Используй фикстуры для подготовки тестовых данных

### TDD подход

- **ВСЕГДА** пиши тесты перед реализацией функциональности
- Следуй циклу Red-Green-Refactor
- Тесты должны быть быстрыми и изолированными
- Один тест проверяет одну вещь

### Запуск тестов

```bash
# Все тесты
cargo test

# Конкретный тест
cargo test test_parse_url

# Тесты с выводом
cargo test -- --nocapture
```

### Покрытие кода

- Используй `cargo-tarpaulin` для проверки покрытия
- Стремись к минимум 70% покрытия для критичных модулей
- Минимум 50% покрытия для всего проекта

## README файлы

- В каждой директории должен быть README.md с описанием архитектуры
- README должен быть на русском языке
- Описывай назначение каждого компонента/модуля


