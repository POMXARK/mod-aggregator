## Скрипты автоматизации

### Основной скрипт запуска inspection

```bash
#!/bin/bash
# scripts/run-inspection.sh

set -e

# Конфигурация
IDEA_PATH="${IDEA_PATH:-/Applications/IntelliJ IDEA CE.app/Contents/MacOS/idea}"
PROJECT_PATH="${PROJECT_PATH:-.}"
OUTPUT_DIR="${OUTPUT_DIR:-./inspection-results}"
FORMAT="${FORMAT:-xml}"
PROFILE="${PROFILE:-Project_Default}"

# Создание выходной директории
mkdir -p "$OUTPUT_DIR"

# Определение файла профиля
PROFILE_PATH="$PROJECT_PATH/.idea/inspectionProfiles/${PROFILE}.xml"
if [ ! -f "$PROFILE_PATH" ]; then
    echo "Warning: Profile $PROFILE_PATH not found, using default"
    PROFILE_PATH=""
fi

# Запуск inspection
echo "Running code inspection..."
echo "Project: $PROJECT_PATH"
echo "Profile: $PROFILE"
echo "Output: $OUTPUT_DIR/results.$FORMAT"

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTPUT_FILE="$OUTPUT_DIR/results_$TIMESTAMP.$FORMAT"

"$IDEA_PATH" inspect "$PROJECT_PATH" ${PROFILE_PATH:+"$PROFILE_PATH"} "$OUTPUT_FILE" -v2

if [ $? -eq 0 ]; then
    echo "Inspection completed successfully"
    echo "Results saved to: $OUTPUT_FILE"

    # Создание символической ссылки на последний результат
    ln -sf "$(basename "$OUTPUT_FILE")" "$OUTPUT_DIR/results.$FORMAT"
else
    echo "Inspection failed"
    exit 1
fi
```

### Скрипт экспорта в JSON для Cursor

```bash
#!/bin/bash
# scripts/export-inspection-results.sh

set -e

INPUT_FILE="$1"
OUTPUT_FILE="${2:-./cursor-inspection.json}"

if [ ! -f "$INPUT_FILE" ]; then
    echo "Error: Input file $INPUT_FILE not found"
    exit 1
fi

# Конвертация XML в JSON
python3 -c "
import xml.etree.ElementTree as ET
import json
import sys
from datetime import datetime

def xml_to_json(xml_file):
    tree = ET.parse(xml_file)
    root = tree.getroot()

    problems = []
    for problem in root.findall('.//problem'):
        file_elem = problem.find('file')
        line_elem = problem.find('line')
        desc_elem = problem.find('description')
        severity_elem = problem.find('severity')
        category_elem = problem.find('category')

        problems.append({
            'file': file_elem.text if file_elem is not None else '',
            'line': int(line_elem.text) if line_elem is not None and line_elem.text.isdigit() else 0,
            'message': desc_elem.text if desc_elem is not None else '',
            'severity': severity_elem.text if severity_elem is not None else 'UNKNOWN',
            'category': category_elem.text if category_elem is not None else '',
            'timestamp': datetime.now().isoformat()
        })

    result = {
        'timestamp': datetime.now().isoformat(),
        'problems': problems,
        'summary': {
            'total': len(problems),
            'errors': len([p for p in problems if p['severity'] == 'ERROR']),
            'warnings': len([p for p in problems if p['severity'] == 'WARNING']),
            'info': len([p for p in problems if p['severity'] == 'INFO'])
        }
    }

    return result

result = xml_to_json('$INPUT_FILE')
with open('$OUTPUT_FILE', 'w', encoding='utf-8') as f:
    json.dump(result, f, indent=2, ensure_ascii=False)

print(f'Converted {len(result[\"problems\"])} problems to JSON')
"

echo "Results exported to: $OUTPUT_FILE"
```

### Скрипт для Git hooks

```bash
#!/bin/bash
# .git/hooks/pre-commit

echo "Running code inspection..."

# Запуск inspection
./scripts/run-inspection.sh --project . --output ./inspection-results --format xml

# Проверка результатов
if [ -f "./inspection-results/results.xml" ]; then
    ERROR_COUNT=$(grep -c 'severity="ERROR"' "./inspection-results/results.xml" 2>/dev/null || echo "0")

    if [ "$ERROR_COUNT" -gt 0 ]; then
        echo "Found $ERROR_COUNT errors. Please fix them before committing."
        echo "See: ./inspection-results/results.xml"
        exit 1
    fi

    WARNING_COUNT=$(grep -c 'severity="WARNING"' "./inspection-results/results.xml" 2>/dev/null || echo "0")
    if [ "$WARNING_COUNT" -gt 0 ]; then
        echo "Found $WARNING_COUNT warnings. Consider fixing them."
    fi
fi

echo "Code inspection passed"
```

