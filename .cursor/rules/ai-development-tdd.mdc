```rust
/// Загружает HTML страницу с сервера или из кэша
/// 
/// # Параметры
/// * `app_handle` - handle приложения Tauri для доступа к файловой системе
/// * `url` - URL страницы для загрузки (должен быть валидным HTTP/HTTPS URL)
/// * `force_refresh` - если `true`, игнорирует кэш и загружает с сервера
/// * `site_id` - ID сайта для привязки кэша (опционально, для группировки кэша по сайтам)
/// 
/// # Возвращает
/// `Result<String, String>` где:
/// - `Ok(html)` - HTML содержимое страницы
/// - `Err(message)` - описание ошибки (сеть, файловая система, валидация)
/// 
/// # Побочные эффекты
/// - Создает/обновляет файлы кэша в `app_data_dir/cache/`
/// - Выполняет HTTP запросы при `force_refresh=true` или отсутствии кэша
/// 
/// # Ошибки
/// - `"Invalid URL"` - URL не является валидным HTTP/HTTPS адресом
/// - `"Network error: ..."` - ошибка при загрузке с сервера
/// - `"Cache error: ..."` - ошибка при работе с файловой системой
/// 
/// # Примеры
/// 
/// ```rust
/// // Загрузка с сервера (игнорируя кэш)
/// let html = fetch_page(app_handle, "https://example.com".to_string(), true, None).await?;
/// 
/// // Загрузка из кэша (если доступен)
/// let html = fetch_page(app_handle, "https://example.com".to_string(), false, Some(1)).await?;
/// ```
pub async fn fetch_page(
    app_handle: tauri::AppHandle, 
    url: String, 
    force_refresh: bool, 
    site_id: Option<i64>
) -> Result<String, String> {
