```

## Моки и фикстуры

### Rust моки

```rust
// Используй mockall для создания моков
use mockall::predicate::*;
use mockall::mock;

mock! {
    Database {
        async fn get_sites(&self) -> Result<Vec<Site>, Error>;
    }
}

#[tokio::test]
async fn test_with_mock() {
    let mut mock_db = MockDatabase::new();
    mock_db.expect_get_sites()
        .times(1)
        .returning(|| Ok(vec![Site::default()]));
    
    let result = mock_db.get_sites().await;
    assert!(result.is_ok());
}
```

### TypeScript моки

```typescript
import { vi } from 'vitest';

// Мок Tauri команды
vi.mock('./lib/tauri-wrapper', () => ({
  invoke: vi.fn().mockResolvedValue([{ id: 1, name: 'Test' }]),
}));
```

