#### 5. Документация типов и структур

Документируй структуры данных и их назначение:

```rust
/// Конфигурация парсера для сайта
/// 
/// Описывает структуру HTML страницы и правила извлечения данных.
/// Используется для генерации парсера через ParserBuilder.
/// 
/// # Пример структуры:
/// ```json
/// {
///   "root": ".mod-list",
///   "children": {
///     "title": ".mod-title",
///     "version": ".mod-version",
///     "link": ".mod-link@href"
///   }
/// }
/// ```
/// 
/// # Особенности:
/// - Селекторы поддерживают CSS синтаксис
/// - Атрибуты извлекаются через `@attribute` синтаксис
/// - Вложенные селекторы создают иерархию результатов
/// - Поддерживаются множественные совпадения
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ParserConfig {
    /// CSS селектор для корневого элемента
    /// Должен быть валидным CSS селектором
    pub root: String,
    
    /// Дочерние селекторы для извлечения данных
    /// Ключ - имя поля, значение - селектор или конфигурация
    pub children: HashMap<String, ParserNode>,
}
```

```typescript
/**
 * Конфигурация парсера для сайта
 * 
 * Используется для описания структуры HTML страницы и правил
 * извлечения данных. Передается в ParserBuilder для создания парсера.
 * 
 * @example
 * ```typescript
 * const config: ParserConfig = {
 *   root: '.mod-list',
 *   children: {
 *     title: '.mod-title',
 *     version: '.mod-version',
 *     link: { selector: '.mod-link', attribute: 'href' }
 *   }
 * };
 * ```
 */
export interface ParserConfig {
  /** CSS селектор для корневого элемента */
  root: string;
  
  /** 
   * Дочерние селекторы для извлечения данных
   * Ключ - имя поля, значение - селектор (string) или конфигурация узла
   */
  children: Record<string, string | ParserNode>;
}
```

