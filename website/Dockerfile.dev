# Dockerfile для разработки
FROM node:18-alpine

WORKDIR /app

# Копирование package файлов
COPY package*.json ./

# Установка зависимостей
RUN npm ci

# Копирование остальных файлов
COPY . .

# Открытие порта
EXPOSE 3000

# Запуск в режиме разработки
CMD ["npm", "start", "--", "--host", "0.0.0.0"]

